}

// =============================================================================
// 8. HOOK (weapon upgrade, all weapons, cap 2)
// =============================================================================
class TFLV_Upgrade_HyperV_Hook : TFLV_Upgrade_BaseUpgrade
{
    override bool IsSuitableForWeapon(TFLV_WeaponInfo info) const
    {
        if (!CVar.FindCVar("hyperv_enabled").GetBool()) return false;
        if (!CVar.FindCVar("hyperv_gb_hook").GetBool()) return false;
        return int(info.upgrades.Level("TFLV_Upgrade_HyperV_Hook"))
            < TFLV_HyperV_UpgradeHelper.MaxLevel("bonsai_hyperv_hook_max_level", 2);
    }
    override void OnActivate(TFLV_PerPlayerStats stats, TFLV_WeaponInfo info)
    {
        uint lv = info.upgrades.Level("TFLV_Upgrade_HyperV_Hook");
        TFLV_HyperV_IntegrationHandler.SetB("vmm_hook",      lv >= 1);
        TFLV_HyperV_IntegrationHandler.SetB("vmm_hook_pull", lv >= 2);
        TFLV_HyperV_IntegrationHandler.SetB("vmm_hook_stun", lv >= 2);
        if (lv >= 2)
        {
            int scaleLvs = max(0, int(lv) - 2);
            TFLV_HyperV_IntegrationHandler.SetF("vmm_hook_stun_dur_min",
                TFLV_HyperV_IntegrationHandler.CVf("bonsai_hyperv_hook_stun_min_base")
                + scaleLvs * TFLV_HyperV_IntegrationHandler.CVf("bonsai_hyperv_hook_stun_min_per_level"));
            TFLV_HyperV_IntegrationHandler.SetF("vmm_hook_stun_dur_max",
                TFLV_HyperV_IntegrationHandler.CVf("bonsai_hyperv_hook_stun_max_base")
                + scaleLvs * TFLV_HyperV_IntegrationHandler.CVf("bonsai_hyperv_hook_stun_max_per_level"));
        }
    }
    override void OnDeactivate(TFLV_PerPlayerStats stats, TFLV_WeaponInfo info)
    {
        if (CVar.FindCVar("hyperv_gb_hook").GetBool())
            TFLV_HyperV_IntegrationHandler.SetB("vmm_hook", false);
    }
    override void GetTooltipFields(Dictionary fields, uint level) const
    {
        double sMinBase = CVar.FindCVar("bonsai_hyperv_hook_stun_min_base").GetFloat();
        double sMaxBase = CVar.FindCVar("bonsai_hyperv_hook_stun_max_base").GetFloat();
        if (level == 0)
        {
            fields.insert("next", "Hook unlocked (surface pull).");
        }
        else if (level == 1)
        {
            fields.insert("next", String.Format("Enemy pull + stun (%.1f-%.1fs).",
                sMinBase, sMaxBase));
        }
        else
        {
            int scaleLvs = max(0, int(level) - 2);
            double sMin = sMinBase + scaleLvs * CVar.FindCVar("bonsai_hyperv_hook_stun_min_per_level").GetFloat();
            double sMax = sMaxBase + scaleLvs * CVar.FindCVar("bonsai_hyperv_hook_stun_max_per_level").GetFloat();
            fields.insert("next", String.Format("Maxed. Stun: %.1f-%.1fs.", sMin, sMax));
        }
    }
}

// =============================================================================
// 9. TELEPORTER (weapon upgrade, all weapons, cap 2)
// =============================================================================
class TFLV_Upgrade_HyperV_Teleporter : TFLV_Upgrade_BaseUpgrade
{
    override bool IsSuitableForWeapon(TFLV_WeaponInfo info) const
    {
        if (!CVar.FindCVar("hyperv_enabled").GetBool()) return false;
        if (!CVar.FindCVar("hyperv_gb_teleporter").GetBool()) return false;
        return int(info.upgrades.Level("TFLV_Upgrade_HyperV_Teleporter"))
            < TFLV_HyperV_UpgradeHelper.MaxLevel("bonsai_hyperv_tp_max_level", 2);
    }
    override void OnActivate(TFLV_PerPlayerStats stats, TFLV_WeaponInfo info)
    {
        uint lv = info.upgrades.Level("TFLV_Upgrade_HyperV_Teleporter");
        TFLV_HyperV_IntegrationHandler.SetB("vmm_teleport", lv >= 1);
        if (lv >= 1)
        {
            int scaleLvs = int(lv) - 1;
            int range = CVar.FindCVar("bonsai_hyperv_tp_range_base").GetInt()
                        + scaleLvs * CVar.FindCVar("bonsai_hyperv_tp_range_per_level").GetInt();
            double cd = max(CVar.FindCVar("bonsai_hyperv_tp_cd_min").GetFloat(),
                CVar.FindCVar("bonsai_hyperv_tp_cd_base").GetFloat()
                - scaleLvs * CVar.FindCVar("bonsai_hyperv_tp_cd_per_level").GetFloat());
            TFLV_HyperV_IntegrationHandler.SetI("vmm_tp_max_range", range);
            TFLV_HyperV_IntegrationHandler.SetF("vmm_tp_cooldown",  cd);
        }
    }
    override void OnDeactivate(TFLV_PerPlayerStats stats, TFLV_WeaponInfo info)
    {
        if (CVar.FindCVar("hyperv_gb_teleporter").GetBool())
            TFLV_HyperV_IntegrationHandler.SetB("vmm_teleport", false);
    }
    override void GetTooltipFields(Dictionary fields, uint level) const
    {
        int base_r   = CVar.FindCVar("bonsai_hyperv_tp_range_base").GetInt();
        int per_r    = CVar.FindCVar("bonsai_hyperv_tp_range_per_level").GetInt();
        double base_cd = CVar.FindCVar("bonsai_hyperv_tp_cd_base").GetFloat();
        double per_cd  = CVar.FindCVar("bonsai_hyperv_tp_cd_per_level").GetFloat();
        double min_cd  = CVar.FindCVar("bonsai_hyperv_tp_cd_min").GetFloat();
        int scaleLvs = max(0, int(level) - 1);
        int range    = base_r + scaleLvs * per_r;
        double cd    = max(min_cd, base_cd - scaleLvs * per_cd);
        fields.insert("range", String.Format("%d units", range));
        fields.insert("cd",    String.Format("%.2fs cooldown", cd));
        fields.insert("next",  level == 0 ? String.Format("Lv1: range %d, %.2fs cd.", base_r, base_cd)
                             : level == 1 ? String.Format("Lv2: range %d, %.2fs cd.", base_r + per_r, max(min_cd, base_cd - per_cd))
                             :              "Scales per level.");
    }
}
