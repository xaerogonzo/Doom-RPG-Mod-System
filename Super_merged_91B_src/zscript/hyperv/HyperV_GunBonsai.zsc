// 7. AGILITY (player upgrade)
// Lv1: +25% speed  Lv2: +35% jump  Lv3+: both scale
// =============================================================================
class TFLV_Upgrade_HyperV_Agility : TFLV_Upgrade_BaseUpgrade
{
    override bool IsSuitableForPlayer(TFLV_PerPlayerStats stats) const
    {
        if (!CVar.FindCVar("hyperv_enabled").GetBool()) return false;
        if (!CVar.FindCVar("hyperv_gb_agility").GetBool()) return false;
        return int(stats.upgrades.Level("TFLV_Upgrade_HyperV_Agility"))
            < TFLV_HyperV_UpgradeHelper.MaxLevel("bonsai_hyperv_agility_max_level", 2);
    }
    override void OnActivate(TFLV_PerPlayerStats stats, TFLV_WeaponInfo info)
    {
        TFLV_HyperV_IntegrationHandler.EnforceForPlayer(stats.owner.PlayerNumber());
    }
    override void GetTooltipFields(Dictionary fields, uint level) const
    {
        int scaleLvs = max(0, int(level) - 2);
        double spd = (level >= 1 ? CVar.FindCVar("bonsai_hyperv_agility_base_speed").GetFloat() : 1.0)
            + scaleLvs * CVar.FindCVar("bonsai_hyperv_agility_speed_per_level").GetFloat();
        double jmp = (level >= 2 ? CVar.FindCVar("bonsai_hyperv_agility_base_jump").GetFloat() : 1.0)
            + scaleLvs * CVar.FindCVar("bonsai_hyperv_agility_jump_per_level").GetFloat();
        fields.insert("speed", String.Format("x%.2f speed", spd));
        fields.insert("jump",  String.Format("x%.2f jump", jmp));
