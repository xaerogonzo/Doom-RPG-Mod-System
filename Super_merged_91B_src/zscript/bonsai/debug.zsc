// #namespace TFLV;

class TFLV_Debug : Object play {
  static void DebugCommand(TFLV_GunBonsaiService service, int player, string cmd, uint arg) {
    Array<string> argv;
    cmd.split(argv, ",");
    if (argv.Size() <= 1) {
      console.printf("Insufficient args.");
    }
    // 0: bonsai-debug, 1: <command>, 2: args...
    if (argv[1] == "info") {
      ShowInfoConsole(players[player].mo);
    } else if (argv[1] == "xpcheck") {
      XPCheck(player);
    } else if (argv[1] == "w-up" && argv.size() >= 3) {
      let upgrade = argv[2];
      if (upgrade.IndexOf(":"..":") == 0) upgrade = "TFLV_Upgrade_" .. upgrade.Mid(2);
      service.GetInt("add-w-upgrade", upgrade, player, arg, null);
    } else if (argv[1] == "p-up" && argv.size() >= 3) {
      let upgrade = argv[2];
      if (upgrade.IndexOf(":"..":") == 0) upgrade = "TFLV_Upgrade_" .. upgrade.Mid(2);
      service.GetInt("add-p-upgrade", upgrade, player, arg);
    } else if (argv[1] == "w-xp") {
      service.GetDouble("add-w-xp", "", player, arg, null);
    } else if (argv[1] == "p-xp") {
      service.GetDouble("add-p-xp", "", player, arg);
    } else if (argv[1] == "gate-test") {
      GateTest();
    } else if (argv[1] == "synth-test") {
      SynthTest(player);
    } else if (argv[1] == "art-spawn" && argv.size() >= 3) {
      // Test helper: spawn an actor (a power-up source, a boss) next to the player.
      class<Actor> cls = (class<Actor>)(argv[2]);
      let pawn = players[player].mo;
      if (cls && pawn) pawn.Spawn(cls, pawn.Vec3Angle(96, pawn.angle, 0));
      else console.printf("BONSAI art-spawn: unknown class %s", argv[2]);
    } else if (argv[1] == "art-choose") {
      // Test helper: answer the open upgrade menu as the player would (index = arg).
      let stats = TFLV_PerPlayerStats.GetStatsFor(players[player].mo);
      if (stats && stats.currentEffectGiver) stats.currentEffectGiver.Choose(arg);
      else console.printf("BONSAI art-choose: no open giver");
    } else if (argv[1] == "cvar-int" && argv.size() >= 3) {
      // Test helper: set an integer cvar from a scenario (the unattended runner cannot use the cvar op).
      let cv = CVar.FindCVar(argv[2]);
      if (cv) cv.SetInt(arg); else console.printf("BONSAI cvar-int: unknown cvar %s", argv[2]);
    } else if (argv[1] == "art-reject") {
      let stats = TFLV_PerPlayerStats.GetStatsFor(players[player].mo);
      if (stats && stats.currentEffectGiver) stats.currentEffectGiver.Choose(-1);
      else console.printf("BONSAI art-reject: no open giver");
    } else if (argv[1] == "w-startlevel") {
      // Test helper: start the ordinary level-up for the current weapon (uses pending XP/bonus levels).
      let stats = TFLV_PerPlayerStats.GetStatsFor(players[player].mo);
      let info = stats ? stats.GetInfoForCurrentWeapon() : null;
      if (info) info.StartLevelUp();
    } else if (argv[1] == "art-info") {
      // Test helper: one line with the current weapon's progression and any open giver.
      let stats = TFLV_PerPlayerStats.GetStatsFor(players[player].mo);
      let info = stats ? stats.GetInfoForCurrentWeapon() : null;
      if (!info) { console.printf("BONSAI art-info: no weapon info"); }
      else {
        let g = stats.currentEffectGiver;
        string gname = "none";
        if (g) gname = g.GetClassName();
        int levels = 0;
        for (uint i = 0; i < info.upgrades.upgrades.Size(); ++i) levels += info.upgrades.upgrades[i].level;
        console.printf("BONSAI art-info level=%d xp=%.1f bonus=%d levels=%d giver=%s cands=%d",
          info.level, info.XP, info.bonus_levels, levels,
          gname, g ? g.candidates.Size() : 0);
      }
    } else if (argv[1] == "dump") {
      Dump(player);
    } else if (argv[1] == "w-level") {
      // Test helper: set the current weapon's level (XP at the start of that level).
      let stats = TFLV_PerPlayerStats.GetStatsFor(players[player].mo);
      let info = stats ? stats.GetInfoForCurrentWeapon() : null;
      if (info) {
        info.level = arg;
        info.XP = info.TotalXPForLevel(arg);
        info.maxXP = info.TotalXPForLevel(arg + 1);
      } else console.printf("w-level: no current weapon info");
    } else if (argv[1] == "w-bonus") {
      // Test helper: set the current weapon's unspent bonus levels.
      let stats = TFLV_PerPlayerStats.GetStatsFor(players[player].mo);
      let info = stats ? stats.GetInfoForCurrentWeapon() : null;
      if (info) info.bonus_levels = arg;
    } else if (argv[1] == "allupgrades") {
      AddAllUpgrades(service, player);
    } else if (argv[1] == "reset") {
      console.printf("Fully resetting all weapon info.");
      let stats = TFLV_PerPlayerStats.GetStatsFor(players[player].mo);
      stats.weapons.clear();
      stats.weaponinfo_dirty = true;
      stats.XP = 0;
      stats.level = 0;
      stats.upgrades = null;
      stats.Initialize(stats.proxy);
    } else {
      console.printf("Unknown or malformed debug command: %s", argv[1]);
    }
  }

  // Test helper: runs the current weapon's Elemental Synthesis upgrade against the first live monster, as a hit would
  // (OnDamageDealt, then the colour, dot and copy helpers), and logs what it collected. Catches table-index bugs.
  static void SynthTest(int player) {
    let pawn = players[player].mo;
    let stats = TFLV_PerPlayerStats.GetStatsFor(pawn);
    let info = stats ? stats.GetInfoForCurrentWeapon() : null;
    if (!info) { console.printf("BONSAI synth-test: no weapon info"); return; }
    TFLV_Upgrade_ElementalSynthesis syn;
    for (uint i = 0; i < info.upgrades.upgrades.Size(); ++i) {
      syn = TFLV_Upgrade_ElementalSynthesis(info.upgrades.upgrades[i]);
      if (syn) break;
    }
    if (!syn) { console.printf("BONSAI synth-test: no synthesis upgrade"); return; }
    Actor victim;
    let it = ThinkerIterator.Create("Actor");
    Actor mo;
    while (mo = Actor(it.Next())) {
      if (mo.bShootable && mo.bIsMonster && mo.health > 0) { victim = mo; break; }
    }
    if (!victim) { console.printf("BONSAI synth-test: no monster"); return; }
    syn.OnDamageDealt(pawn, null, victim, 10);
    int c0 = syn.GetColour(0);
    int c1 = syn.GetColour(1);
    bool has = syn.HasDots(victim);
    syn.CopyElements(victim, victim);
    console.printf("BONSAI synth-test elements=%d colour0=%x colour1=%x hasdots=%d done", syn.elements.Size(), c0, c1, has ? 1 : 0);
  }

  // Read-only, deterministic listing of every weapon's progression and upgrades, the player's
  // level/XP and the last death penalty. One "BONSAI ..." line each so tests can match them.
  static void Dump(int player) {
    let stats = TFLV_PerPlayerStats.GetStatsFor(players[player].mo);
    if (!stats) { console.printf("BONSAI dump: no stats"); return; }
    console.printf("BONSAI player level=%d xp=%d score=%d score_to_xp=%.2f damage_to_xp=%.2f",
      stats.level, stats.XP, players[player].mo.score, bonsai_score_to_xp_factor, bonsai_damage_to_xp_factor);
    for (uint i = 0; stats.upgrades && i < stats.upgrades.upgrades.Size(); ++i) {
      let u = stats.upgrades.upgrades[i];
      let ecm = TFLV_Upgrade_ECM(u);
      if (ecm) console.printf("BONSAI ecm redirected=%d reprogrammed=%d failed=%d pending=%d",
        ecm.n_redirected, ecm.n_reprogrammed, ecm.n_failed, ecm.pending.Size());
      console.printf("BONSAI pupgrade class=%s level=%d max=%d enabled=%d", u.GetClassName(), u.level, u.max_level, u.enabled);
    }
    for (int w = 0; w < stats.weapons.Size(); ++w) {
      let info = stats.weapons[w];
      if (!info) continue;
      console.printf("BONSAI weapon class=%s level=%d xp=%.1f maxxp=%.1f bonus_levels=%d",
        info.wpnClass, info.level, info.XP, info.maxXP, info.bonus_levels);
      for (uint i = 0; info.upgrades && i < info.upgrades.upgrades.Size(); ++i) {
        let u = info.upgrades.upgrades[i];
        console.printf("BONSAI upgrade weapon=%s class=%s level=%d max=%d enabled=%d",
          info.wpnClass, u.GetClassName(), u.level, u.max_level, u.enabled);
      }
    }
    console.printf("BONSAI bounce_cues_given=%d", stats.bounceCuesGiven);
    console.printf("BONSAI submunition_cues_given=%d alive=%d source=%d", stats.submunitionCuesGiven, stats.submunitionsAlive, stats.submunitionCueSource ? 1 : 0);
    console.printf("BONSAI death_penalty requested=%d levels_lost=%d upgrades_removed=%d weapons=%d",
      stats.lastPenaltyRequested, stats.lastPenaltyLevelsLost,
      stats.lastPenaltyUpgradesRemoved, stats.lastPenaltyWeapons);
    console.printf("BONSAI end");
  }

  // Logic test for the shared defense-cue gate with synthetic tics (no game state is touched).
  // Prints "BONSAI gate result=..." : 1 = the cue would play, 0 = blocked.
  static void GateTest() {
    let st = new("TFLV_PerPlayerStats");
    // {tic, kind, gap}
    static const int steps[] = {   // kind: 1 = Thorns, 2 = Shield
      100, 2, 12,  100, 1, 20,  100, 1, 20,  105, 2, 12,  119, 1, 20,  120, 1, 20,  120, 2, 12,
      200, 2, 12,  205, 2, 12,  212, 2, 12,
      300, 1, 20,  315, 1, 20,  320, 1, 20 };
    string r = "";
    for (int i = 0; i < 13; ++i) {
      int now = steps[i*3], kind = steps[i*3+1], gap = steps[i*3+2];
      bool ok = st.DefenseCueOpen(now, kind);
      if (ok) st.DefenseCueClaim(now, kind, gap);
      r = r .. (ok ? "1" : "0");
    }
    console.printf("BONSAI gate result=%s", r);
    // Bouncy Shots gate: one projectile per 25 tics. Expected 1,0,0,1,0,1
    let bs = new("TFLV_PerPlayerStats");
    static const int btics[] = { 100, 110, 124, 125, 140, 150 };
    string br = "";
    for (int i = 0; i < 6; ++i) br = br .. (bs.BounceCueTry(btics[i], 25) ? "1" : "0");
    console.printf("BONSAI bounce gate result=%s", br);
    // Submunitions bomblet counter: 3 spawned, then 4 deaths: only the third death is "the last". Expected 0010
    let ss = new("TFLV_PerPlayerStats");
    ss.SubmunitionSpawned(); ss.SubmunitionSpawned(); ss.SubmunitionSpawned();
    string sr = "";
    for (int i = 0; i < 4; ++i) sr = sr .. (ss.SubmunitionGone() ? "1" : "0");
    console.printf("BONSAI submunition counter result=%s", sr);
    // Elemental cue gates: independent per element, 20-tic window. {tic, kind}. Expected 101101
    let es = new("TFLV_PerPlayerStats");
    static const int etics[] = { 100, 0,  110, 0,  110, 1,  120, 0,  129, 1,  130, 1 };
    string er = "";
    for (int i = 0; i < 6; ++i) {
      bool ok = es.ElemCueOpen(etics[i*2], etics[i*2+1]);
      if (ok) es.ElemCueClaim(etics[i*2], etics[i*2+1], 20);
      er = er .. (ok ? "1" : "0");
    }
    console.printf("BONSAI elem gate result=%s", er);
    // Acid (2) and Poison (3) gates are independent too. {tic, kind}. Expected 1110011
    let as2 = new("TFLV_PerPlayerStats");
    static const int atics[] = { 100, 2,  100, 3,  110, 0,  110, 2,  119, 3,  120, 2,  125, 3 };
    string ar = "";
    for (int i = 0; i < 7; ++i) {
      bool ok = as2.ElemCueOpen(atics[i*2], atics[i*2+1]);
      if (ok) as2.ElemCueClaim(atics[i*2], atics[i*2+1], 20);
      ar = ar .. (ok ? "1" : "0");
    }
    console.printf("BONSAI elem gate2 result=%s", ar);
    // Blood (4) and Kiln (5) gates, gap 40. {tic, kind}. Expected 1101
    let bs2 = new("TFLV_PerPlayerStats");
    static const int btics2[] = { 100, 4,  100, 5,  120, 4,  140, 5 };
    string br2 = "";
    for (int i = 0; i < 4; ++i) {
      bool ok = bs2.ElemCueOpen(btics2[i*2], btics2[i*2+1]);
      if (ok) bs2.ElemCueClaim(btics2[i*2], btics2[i*2+1], 40);
      br2 = br2 .. (ok ? "1" : "0");
    }
    console.printf("BONSAI elem gate3 result=%s", br2);
  }

  static void ShowInfoConsole(Actor pawn) {
    TFLV_CurrentStats stats;
    if (!TFLV_PerPlayerStats.GetStatsFor(pawn).GetCurrentStats(stats)) {
      console.printf("Error getting current stats for player.");
      return;
    }
    console.printf("Player:\n    Level %d (%d/%d XP)",
      stats.plvl, stats.pxp, stats.pmax);
    stats.pupgrades.DumpToConsole("    ");
    console.printf("%s (%s):\n    Level %d (%d/%d XP)",
      stats.winfo.wpnClass, stats.wname, stats.wlvl, stats.wxp, stats.wmax);
    stats.wupgrades.DumpToConsole("    ");
    stats.winfo.DumpTypeInfo();
  }

  // Diagnostic: print all XP-related CVar values and current weapon XP state.
  // Usage: netevent bonsai-debug,xpcheck
  static void XPCheck(int player) {
    let pawn = players[player].mo;
    if (!pawn) { console.printf("XPCheck: no pawn"); return; }

    console.printf("=== XP Diagnostic ===");
    if (bonsai_enabled)           console.printf("bonsai_enabled: true");
    else                          console.printf("bonsai_enabled: false");
    if (bonsai_freeze_progression) console.printf("bonsai_freeze_progression: true");
    else                           console.printf("bonsai_freeze_progression: false");
    console.printf("bonsai_damage_to_xp_factor: %.2f", bonsai_damage_to_xp_factor);
    console.printf("bonsai_score_to_xp_factor:  %.2f", bonsai_score_to_xp_factor);
    console.printf("player.score: %d", pawn.score);

    let stats = TFLV_PerPlayerStats.GetStatsFor(pawn);
    if (!stats) { console.printf("XPCheck: no PerPlayerStats - not initialized"); return; }

    console.printf("prevScore: %d", stats.prevScore);

    if (!stats.proxy) {
      console.printf("proxy: NULL");
    } else {
      console.printf("proxy: ok");
      bool inPoll = stats.proxy.InStateSequence(
        stats.proxy.CurState, stats.proxy.FindState("Poll"));
      if (inPoll) console.printf("proxy in Poll: true");
      else        console.printf("proxy in Poll: false");
    }

    let info = stats.GetInfoForCurrentWeapon();
    if (!info) {
      console.printf("GetInfoForCurrentWeapon: NULL");
      if (pawn.player.ReadyWeapon)
        console.printf("ReadyWeapon: %s", pawn.player.ReadyWeapon.GetClassName());
      else
        console.printf("ReadyWeapon: none");
      if (stats.infoForCurrentWeapon)
        console.printf("infoForCurrentWeapon.wpnClass: %s", stats.infoForCurrentWeapon.wpnClass);
      else
        console.printf("infoForCurrentWeapon: null");
      console.printf("(fire at an enemy first, then re-run xpcheck)");
    } else {
      console.printf("weapon: %s  XP: %.1f / %.1f  level: %d",
        info.wpnClass, info.XP, info.maxXP, info.level);
    }
    console.printf("=== End XP Diagnostic ===");
  }

  static void AddAllUpgrades(TFLV_GunBonsaiService service, int player) {
    let registry = TFLV_Upgrade_Registry.GetRegistry();
    for (uint i = 0; i < registry.upgrades.size(); ++i) {
      service.GetInt("add-w-upgrade", registry.upgrades[i].GetClassName(), player, 1, null);
      service.GetInt("add-p-upgrade", registry.upgrades[i].GetClassName(), player, 1);
    }
  }
}
