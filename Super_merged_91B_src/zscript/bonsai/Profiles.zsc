// =============================================================================
// Public API
// =============================================================================

  static void Apply(int profile)
  {
    Array<String> floatNames, intNames;
    Array<double> floatVals;
    Array<int>    intVals;
    GetFloatCVarNames(floatNames);
    GetIntCVarNames(intNames);

    String stored = GetStoredString(profile);
    // Sanity-check the stored string: valid saves contain "=" separators.
    // The old buggy format used Dictionary.ToString() which produces JSON-like
    // output incompatible with our parser — detect and discard it gracefully.
    bool validStored = stored.Length() > 0 && stored.IndexOf("=") >= 0
                       && stored.IndexOf("{") < 0;
    if (validStored)
      Deserialize(stored, profile, floatNames, intNames, floatVals, intVals);
    else
    {
      if (stored.Length() > 0)
        Console.PrintF("\c[ORANGE]Gun Bonsai:\c- Saved profile data was in an old format and has been discarded. Applying hardcoded defaults.");
      GetHardcodedFloats(profile, floatVals);
      GetHardcodedInts(profile, intVals);
    }

    ApplyAllCVars(floatNames, floatVals, intNames, intVals);

    static const String NAMES[] = {
      "Default", "Balanced", "Challenging", "Punishing", "Custom", "Brutal Mode"
    };
    String pname = (profile >= 0 && profile <= 5) ? NAMES[profile] : "Unknown";
    bool wasSaved = (stored.Length() > 0);
    Console.PrintF("\c[CYAN]Gun Bonsai:\c- Applied \c[GOLD]%s\c- profile (%s).",
      pname, wasSaved ? "from saved data" : "hardcoded defaults");
  }

  static void Save(int profile)
  {
    if (profile < 0 || profile > 5)
    {
      Console.PrintF("\c[CYAN]Gun Bonsai:\c- Invalid profile index.");
      return;
    }

    static const String STORECVARS[] = {
      "bonsai_profile_0", "bonsai_profile_1", "bonsai_profile_2",
      "bonsai_profile_3", "bonsai_profile_4", "bonsai_profile_5"
    };
    CVar storeCv = CVar.FindCVar(STORECVARS[profile]);
    if (!storeCv)
    {
      Console.PrintF("\c[RED]Gun Bonsai:\c- ERROR: storage CVar not found. Profile not saved.");
      return;
    }

    Array<String> floatNames, intNames;
    GetFloatCVarNames(floatNames);
    GetIntCVarNames(intNames);

    // Serialize as "key=value,key=value,..." — no JSON dependency, safe to parse
    // back with simple split. Comma separator; values never contain commas.
    String serial = "";
    for (int i = 0; i < floatNames.Size(); ++i)
    {
      CVar cv = CVar.FindCVar(floatNames[i]);
      if (!cv) continue;
      if (serial.Length() > 0) serial = serial .. ",";
      serial = serial .. floatNames[i] .. "=" .. String.Format("%.6f", cv.GetFloat());
    }
    for (int i = 0; i < intNames.Size(); ++i)
    {
      CVar cv = CVar.FindCVar(intNames[i]);
      if (!cv) continue;
      if (serial.Length() > 0) serial = serial .. ",";
      serial = serial .. intNames[i] .. "=" .. String.Format("%d", cv.GetInt());
    }

    storeCv.SetString(serial);

    static const String NAMES[] = {
      "Default", "Balanced", "Challenging", "Punishing", "Custom", "Brutal Mode"
    };
    Console.PrintF("\c[CYAN]Gun Bonsai:\c- Saved to \c[GOLD]%s\c- profile.", NAMES[profile]);
  }

  static void Reset(int profile)
  {
    if (profile >= 0 && profile <= 5)
      SetStoredString(profile, "");

    Array<String> floatNames, intNames;
    Array<double> floatVals;
    Array<int>    intVals;
    GetFloatCVarNames(floatNames);
    GetIntCVarNames(intNames);
    GetHardcodedFloats(profile, floatVals);
    GetHardcodedInts(profile, intVals);
    ApplyAllCVars(floatNames, floatVals, intNames, intVals);

    static const String NAMES[] = {
      "Default", "Balanced", "Challenging", "Punishing", "Custom", "Brutal Mode"
    };
    Console.PrintF("\c[CYAN]Gun Bonsai:\c- \c[GOLD]%s\c- profile reset to built-in defaults.",
      (profile >= 0 && profile <= 5) ? NAMES[profile] : "Unknown");
  }

// =============================================================================
// Internal helpers
// =============================================================================

  private static String GetStoredString(int profile)
  {
    static const String CVARS[] = {
      "bonsai_profile_0", "bonsai_profile_1", "bonsai_profile_2",
      "bonsai_profile_3", "bonsai_profile_4", "bonsai_profile_5"
    };
    if (profile < 0 || profile > 5) return "";
    CVar cv = CVar.FindCVar(CVARS[profile]);
    return cv ? cv.GetString() : "";
  }

  private static void SetStoredString(int profile, String value)
  {
    static const String CVARS[] = {
      "bonsai_profile_0", "bonsai_profile_1", "bonsai_profile_2",
      "bonsai_profile_3", "bonsai_profile_4", "bonsai_profile_5"
    };
    if (profile < 0 || profile > 5) return;
    CVar cv = CVar.FindCVar(CVARS[profile]);
    if (cv) cv.SetString(value);
  }

  private static void GetHardcodedFloats(int profile, out Array<double> v)
  {
    switch (profile)
    {
      case 1:  BalancedFloats(v);    return;
      case 2:  ChallengingFloats(v); return;
      case 3:  PunishingFloats(v);   return;
      case 5:  BrutalFloats(v);      return;
      default: DefaultFloats(v);     return;
    }
  }

  private static void GetHardcodedInts(int profile, out Array<int> v)
  {
    switch (profile)
    {
      case 1:  BalancedInts(v);    return;
      case 2:  ChallengingInts(v); return;
      case 3:  PunishingInts(v);   return;
      case 5:  BrutalInts(v);      return;
      default: DefaultInts(v);     return;
    }
  }

  private static void ApplyAllCVars(
    Array<String> fNames, Array<double> fVals,
    Array<String> iNames, Array<int>    iVals)
  {
    for (int i = 0; i < fNames.Size() && i < fVals.Size(); ++i)
    {
      CVar cv = CVar.FindCVar(fNames[i]);
      if (cv) cv.SetFloat(fVals[i]);
      else Console.PrintF("\c[RED]Gun Bonsai Profile:\c- float CVar not found: %s", fNames[i]);
    }
    for (int i = 0; i < iNames.Size() && i < iVals.Size(); ++i)
    {
      CVar cv = CVar.FindCVar(iNames[i]);
      if (cv) cv.SetInt(iVals[i]);
      else Console.PrintF("\c[RED]Gun Bonsai Profile:\c- int CVar not found: %s", iNames[i]);
    }
  }

  // Deserialize a Dictionary-format profile string.
  // Keys missing from the stored Dictionary fall back to the slot's hardcoded
  // defaults — handles profiles saved before new CVars were added.
  private static void Deserialize(
    String stored, int profile,
    Array<String> floatNames, Array<String> intNames,
    out Array<double> fVals, out Array<int> iVals)
  {
    // Parse "key=value,key=value,..." into a lookup Dictionary manually.
    // This avoids Dictionary.fromString() which requires strict JSON format.
    Dictionary lookup = Dictionary.Create();
    Array<String> pairs;
    stored.Split(pairs, ",");
    for (int p = 0; p < pairs.Size(); ++p)
    {
      int eq = pairs[p].IndexOf("=");
      if (eq < 1) continue;
      String k = pairs[p].Left(eq);
      String v = pairs[p].Mid(eq + 1);
      lookup.Insert(k, v);
    }

    Array<double> fallbackF;
    Array<int>    fallbackI;
    GetHardcodedFloats(profile, fallbackF);
    GetHardcodedInts(profile, fallbackI);

    for (int i = 0; i < floatNames.Size(); ++i)
    {
      String val = lookup.at(floatNames[i]);
      fVals.Push(val.Length() > 0 ? val.ToDouble() : fallbackF[i]);
    }
    for (int i = 0; i < intNames.Size(); ++i)
    {
      String val = lookup.at(intNames[i]);
      iVals.Push(val.Length() > 0 ? val.ToInt() : fallbackI[i]);
    }
  }


  // =========================================================================
  // Export — prints all saved profile strings to the console.
  // Each non-empty slot is printed as a console command the recipient can
  // paste directly: bonsai_profile_N "dictionary-string"
  // Empty slots (never saved to) print a note so the user knows.
  // =========================================================================
  static void ExportSlot(int slot)
  {
    if (slot < 0 || slot > 5) return;

    static const String NAMES[] = {
      "Default", "Balanced", "Challenging", "Punishing", "Custom", "Brutal Mode"
    };
    static const String CVARS[] = {
      "bonsai_profile_0", "bonsai_profile_1", "bonsai_profile_2",
      "bonsai_profile_3", "bonsai_profile_4", "bonsai_profile_5"
    };

    CVar cv = CVar.FindCVar(CVARS[slot]);
    if (!cv) return;
    String stored = cv.GetString();

    Console.PrintF("\c[CYAN]=== Gun Bonsai Export: %s (Slot %d) ===\c-", NAMES[slot], slot);

    if (stored.Length() == 0)
    {
      Console.PrintF("\c[ORANGE]This slot has no saved data.\c-");
      Console.PrintF("\c[GRAY]Use Save to %s first, then export.\c-", NAMES[slot]);
    }
    else
    {
      Console.PrintF("\c[GRAY]Paste this into your console to import:\c-");
      Console.PrintF("\c[WHITE]%s \"%s\"\c-", CVARS[slot], stored);
      Console.PrintF("\c[GRAY]Then Apply the %s profile from the Profiles menu.\c-", NAMES[slot]);
    }

    Console.PrintF("\c[CYAN]========================================\c-");
  }

} // class TFLV_Profiles
