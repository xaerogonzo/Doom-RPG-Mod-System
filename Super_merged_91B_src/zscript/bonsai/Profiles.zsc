// =============================================================================
// TFLV_Profiles — Balance & Upgrade Pool profile system (Dictionary-based)
//
// Six profiles (all equal in structure, differ only in hardcoded defaults):
//   0 = Default       (vanilla Gun Bonsai)
//   1 = Balanced
//   2 = Challenging
//   3 = Punishing
//   4 = Custom
//   5 = Brutal Mode
//
// Storage: one Dictionary-string CVar per slot (bonsai_profile_0 .. _5).
//   Format: ZScript Dictionary.toString() — self-describing key=value pairs.
//   Unknown keys on load are silently skipped (forward-compatible).
//   Missing keys fall back to the slot's hardcoded defaults (backward-compatible).
//
// Each profile stores ALL tunable CVars:
//   - bonsai_stat_* floats and ints  (balance tuning)
//   - bonsai_upg_*  ints             (upgrade pool rarity tiers, 0-5)
//   - bonsai_weight_* ints           (tier weight multipliers)
//   - pacing CVars                   (base cost, xp curve, xp factors)
//
// Triggered by netevents (relayed from ConsoleProcess):
//   bonsai-profile-apply-N   N = 0-5
//   bonsai-profile-save-N    N = 0-5
//   bonsai-profile-reset-N   N = 0-5
// =============================================================================

class TFLV_Profiles play
{

// =============================================================================
// CVar name lists — defines what gets serialized into each profile
// =============================================================================

  static void GetFloatCVarNames(out Array<String> n)
  {
    // Player upgrades (0-4)
    n.Push("bonsai_stat_player_damage");
    n.Push("bonsai_stat_weapon_damage");
    n.Push("bonsai_stat_tough_as_nails");
    n.Push("bonsai_stat_blast_shaping");
    n.Push("bonsai_stat_rapid_fire");
    // Projectile modifiers (5-9)
    n.Push("bonsai_stat_ricochet_damage");
    n.Push("bonsai_stat_piercing_damage");
    n.Push("bonsai_stat_explosive_damage");
    n.Push("bonsai_stat_frag_damage");
    n.Push("bonsai_stat_frag_arc");
    // Explosive / submunitions / homing (10-14)
    n.Push("bonsai_stat_submunitions_health_scale");
    n.Push("bonsai_stat_submunitions_lifetime");
    n.Push("bonsai_stat_explosivedeath_scale");
    n.Push("bonsai_stat_homing_turn_rate");
    n.Push("bonsai_stat_flare_decay");
    // Shield / sweep / cleave (15-20)
    n.Push("bonsai_stat_shield_melee_base");
    n.Push("bonsai_stat_shield_ranged_base");
    n.Push("bonsai_stat_sweep_base");
    n.Push("bonsai_stat_sweep_decay");
    n.Push("bonsai_stat_cleave_overkill");
    n.Push("bonsai_stat_cleave_health_cap");
    // Swiftness / sustain (21-25)
    n.Push("bonsai_stat_swiftness_base_tics");
    n.Push("bonsai_stat_swiftness_level_tics");
    n.Push("bonsai_stat_swiftness_combo_tics");
    n.Push("bonsai_stat_darkharvest_cap_per_level");
    n.Push("bonsai_stat_bandoliers_bonus");
    // Elemental synthesis (26-27)
    n.Push("bonsai_stat_elemblast_radius");
    n.Push("bonsai_stat_elemwave_radius");
    // Fire (28-34)
    n.Push("bonsai_stat_fire_mult");
    n.Push("bonsai_stat_fire_stack_rate");
    n.Push("bonsai_stat_fire_cutoff");
    n.Push("bonsai_stat_fire_heat_factor");
    n.Push("bonsai_stat_fire_damage_per_stack");
    n.Push("bonsai_stat_fire_terror_base");
    n.Push("bonsai_stat_fire_terror_damage");
    // Poison (35-43)
    n.Push("bonsai_stat_poison_mult");
    n.Push("bonsai_stat_poison_stacks_per_hit");
    n.Push("bonsai_stat_poison_softcap_factor");
    n.Push("bonsai_stat_poison_drain_rate");
    n.Push("bonsai_stat_poison_weakness_base");
    n.Push("bonsai_stat_poison_hallu_damage");
    n.Push("bonsai_stat_poison_hallu_armour");
    n.Push("bonsai_stat_poison_hallu_drain");
    n.Push("bonsai_stat_poison_putref_transfer");
    // Acid (44-52)
    n.Push("bonsai_stat_acid_mult");
    n.Push("bonsai_stat_acid_stack_base");
    n.Push("bonsai_stat_acid_stack_per_level");
    n.Push("bonsai_stat_acid_base_threshold");
    n.Push("bonsai_stat_acid_dps_above");
    n.Push("bonsai_stat_acid_dps_mult");
    n.Push("bonsai_stat_acid_concentration_threshold");
    n.Push("bonsai_stat_acid_concentration_drain");
    n.Push("bonsai_stat_acid_embrit_damage");
    // Lightning (53-61)
    n.Push("bonsai_stat_lightning_mult");
    n.Push("bonsai_stat_lightning_stack_rate");
    n.Push("bonsai_stat_lightning_softcap");
    n.Push("bonsai_stat_lightning_tbolt_stun_base");
    n.Push("bonsai_stat_lightning_tbolt_stun_per_level");
    n.Push("bonsai_stat_lightning_tbolt_cap_base");
    n.Push("bonsai_stat_lightning_chain_radius");
    n.Push("bonsai_stat_lightning_reviv_damage");
    n.Push("bonsai_stat_lightning_reviv_armour");
    // Pacing (62-65) — previously only 62-63 were here; 64-65 were missing
