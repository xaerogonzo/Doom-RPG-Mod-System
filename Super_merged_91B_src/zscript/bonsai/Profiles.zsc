  static void GetIntCVarNames(out Array<String> n)
  {
    // Explosives (0-1)
    n.Push("bonsai_stat_explosive_radius");
    n.Push("bonsai_stat_explosive_radius_per_level");
    // Fragmentation (2-3)
    n.Push("bonsai_stat_frag_base_count");
    n.Push("bonsai_stat_frag_per_level");
    // Submunitions (4-5)
    n.Push("bonsai_stat_submunitions_base");
    n.Push("bonsai_stat_submunitions_bonus_damage");
    // Projectile / utility ranges (6-8)
    n.Push("bonsai_stat_homing_base_range");
    n.Push("bonsai_stat_ricochet_range");
    n.Push("bonsai_stat_flare_base_range");
    // Aggressive defence / ECM (9-14)
    n.Push("bonsai_stat_agdef_base_radius");
    n.Push("bonsai_stat_agdef_radius_per_level");
    n.Push("bonsai_stat_ecm_base_range");
    n.Push("bonsai_stat_ecm_range_per_level");
    n.Push("bonsai_stat_ecm_lock_base");
    n.Push("bonsai_stat_ecm_lock_per_level");
    // Thorns / leech (15-18)
    n.Push("bonsai_stat_thorns_min_range");
    n.Push("bonsai_stat_thorns_max_range");
    n.Push("bonsai_stat_lifeleech_boss_mul");
    n.Push("bonsai_stat_armourleech_boss_mul");
    // Poison / acid / lightning ranges (19-23)
    n.Push("bonsai_stat_poison_putref_radius");
    n.Push("bonsai_stat_acid_spray_base_range");
    n.Push("bonsai_stat_acid_spray_range_per_level");
    n.Push("bonsai_stat_lightning_tbolt_radius_base");
    n.Push("bonsai_stat_lightning_tbolt_radius_per_level");
    // Pacing (24-28) — previously 24-26; upgrade_choices and hybrid were missing
    n.Push("bonsai_base_level_cost");
    n.Push("bonsai_xp_curve");
    n.Push("bonsai_gun_levels_per_player_level");
    n.Push("bonsai_upgrade_choices_per_gun_level");
    n.Push("bonsai_upgrade_choices_per_player_level");
    // Hybrid curve: component selectors
    n.Push("bonsai_hybrid_component_a");
    n.Push("bonsai_hybrid_component_b");
    // Hybrid curve: transition range
    n.Push("bonsai_hybrid_transition_start");
    n.Push("bonsai_hybrid_transition_end");
    // Overdrive (33) — must be here before tier weights to match DefaultInts positional order.
    // DefaultInts pushes overdrive at position 33, then DefaultPoolInts starts with weights at 34.
    n.Push("bonsai_stat_overdrive_max_stacks");
    // Tier weights (34-39) — positional order must match DefaultPoolInts which starts with these.
    // -----------------------------------------------------------------------
    n.Push("bonsai_weight_disabled");
    n.Push("bonsai_weight_veryrare");
    n.Push("bonsai_weight_rare");
    n.Push("bonsai_weight_uncommon");
    n.Push("bonsai_weight_common");
    n.Push("bonsai_weight_favored");
    // -----------------------------------------------------------------------
    // Indestructible GB integration (appended — safe for old profile strings)
    n.Push("bonsai_indestructible_max_level");
    n.Push("bonsai_indestructible_base_max_lives");
    n.Push("bonsai_indestructible_lives_on_clear");
    n.Push("bonsai_indestructible_base_lives_per_clear");
    n.Push("bonsai_indestructible_lives_on_boss");
    n.Push("bonsai_indestructible_boss_kill_level");
    n.Push("bonsai_indestructible_lives_on_damage");
    n.Push("bonsai_indestructible_damage_per_life");
    // Companions GB integration
    n.Push("bonsai_companions_max_level");
    n.Push("bonsai_companions_base_allies");
    n.Push("bonsai_companions_allies_per_level");
    n.Push("bonsai_companions_max_allies");
    n.Push("bonsai_companions_boss_min_level");
    n.Push("bonsai_companions_archvile_min_level");
    n.Push("bonsai_companions_base_revives");
    n.Push("bonsai_companions_revives_per_level");
    // NOTE: bonsai_upg_* (upgrade pool rarity tiers) are intentionally NOT
    // listed here. They are user preferences that persist independently and
    // must never be overwritten by profile apply/reset. Adding them here
    // caused saved profiles to zero them all out (tier 0 = Disabled) because
    // the fallback path returned out-of-bounds array values.
    // *** Append new int CVars here — do not reorder above ***
    // Hyper-V max level CVars
    n.Push("bonsai_hyperv_mobility_max_level");
    n.Push("bonsai_hyperv_melee_max_level");
    n.Push("bonsai_hyperv_slomo_max_level");
    n.Push("bonsai_hyperv_hregen_max_level");
    n.Push("bonsai_hyperv_aregen_max_level");
    n.Push("bonsai_hyperv_ammoregen_max_level");
    n.Push("bonsai_hyperv_agility_max_level");
    n.Push("bonsai_hyperv_hook_max_level");
    n.Push("bonsai_hyperv_tp_max_level");
    // Hyper-V int scaling CVars
    n.Push("bonsai_hyperv_melee_dmg_per_level");
    n.Push("bonsai_hyperv_melee_crit_per_level");
    n.Push("bonsai_hyperv_melee_parry_per_level");
    n.Push("bonsai_hyperv_slomo_pts_per_level");
    n.Push("bonsai_hyperv_slomo_depth_per_level");
    n.Push("bonsai_hyperv_hregen_cap_per_level");
    n.Push("bonsai_hyperv_aregen_cap_per_level");
    // Hyper-V int base value CVars (appended — do not reorder above)
    n.Push("bonsai_hyperv_melee_base_dmg_min");
    n.Push("bonsai_hyperv_melee_base_dmg_max");
    n.Push("bonsai_hyperv_melee_base_tics");
    n.Push("bonsai_hyperv_melee_base_crit");
    n.Push("bonsai_hyperv_melee_base_parry");
    n.Push("bonsai_hyperv_hregen_cap_base");
    n.Push("bonsai_hyperv_aregen_cap_lv1");
    n.Push("bonsai_hyperv_aregen_cap_lv2");
    n.Push("bonsai_hyperv_slomo_pts_lv1");
    n.Push("bonsai_hyperv_slomo_pts_lv2");
    n.Push("bonsai_hyperv_slomo_base_depth");
    n.Push("bonsai_hyperv_tp_range_lv1");
    n.Push("bonsai_hyperv_tp_range_lv2");
    // Hyper-V new int/bool CVars (appended — do not reorder above)
    n.Push("bonsai_hyperv_slomo_any_weapon");  // bool stored as 0/1
    n.Push("bonsai_hyperv_hregen_amount");
    n.Push("bonsai_hyperv_aregen_amount");
    // NOTE: bonsai_upg_hyperv_* rarity CVars are also excluded here,
    // same reason as the bonsai_upg_* block above.
  }

// =============================================================================
// Hardcoded profile data
// =============================================================================

  // Pool defaults: identical across all profiles. Applied when a slot has
  // never been saved to (or after Reset). The player customises per slot.
  private static void DefaultPoolInts(out Array<int> v)
  {
    // Tier weights — identical across all profiles.
    // bonsai_upg_* rarity CVars are intentionally excluded; they are user
    // preferences and must never be overwritten by profile apply/reset.
    v.Push(0);  // bonsai_weight_disabled
    v.Push(1);  // bonsai_weight_veryrare
    v.Push(3);  // bonsai_weight_rare
    v.Push(6);  // bonsai_weight_uncommon
    v.Push(10); // bonsai_weight_common
    v.Push(20); // bonsai_weight_favored
    // Indestructible GB integration — shared defaults across all profiles.
    v.Push(4);   // bonsai_indestructible_max_level
    v.Push(1);   // bonsai_indestructible_base_max_lives
    v.Push(1);   // bonsai_indestructible_lives_on_clear  (bool as 0/1)
    v.Push(1);   // bonsai_indestructible_base_lives_per_clear
    v.Push(1);   // bonsai_indestructible_lives_on_boss   (bool as 0/1)
    v.Push(3);   // bonsai_indestructible_boss_kill_level
    v.Push(1);   // bonsai_indestructible_lives_on_damage (bool as 0/1)
    v.Push(400); // bonsai_indestructible_damage_per_life
    // Companions GB integration — shared defaults across all profiles.
    v.Push(6);   // bonsai_companions_max_level
    v.Push(1);   // bonsai_companions_base_allies
    v.Push(1);   // bonsai_companions_allies_per_level
    v.Push(8);   // bonsai_companions_max_allies
    v.Push(3);   // bonsai_companions_boss_min_level
    v.Push(2);   // bonsai_companions_archvile_min_level
    v.Push(1);   // bonsai_companions_base_revives
    v.Push(1);   // bonsai_companions_revives_per_level
    // Hyper-V max level CVars — shared defaults across all profiles.
    v.Push(3); v.Push(6); v.Push(4); v.Push(5); v.Push(4); v.Push(3); v.Push(4); v.Push(2); v.Push(2);
    // mobility, melee, slomo, hregen, aregen, ammoregen, agility, hook, tp max_level
    // Hyper-V int scaling CVars
    v.Push(2); v.Push(1); v.Push(5); v.Push(40); v.Push(10); v.Push(15); v.Push(25);
    // melee_dmg, melee_crit, melee_parry, slomo_pts, slomo_depth, hregen_cap, aregen_cap _per_level
    // Hyper-V int base value CVars
    v.Push(1); v.Push(6); v.Push(35); v.Push(4); v.Push(10); // melee: base_dmg_min/max, base_tics, base_crit, base_parry
    v.Push(25);                                               // hregen_cap_base
    v.Push(50); v.Push(100);                                  // aregen_cap_lv1, aregen_cap_lv2
    v.Push(120); v.Push(200); v.Push(100);                    // slomo_pts_lv1/2, slomo_base_depth
    v.Push(1024); v.Push(2048);                               // tp_range_lv1, tp_range_lv2
    // Hyper-V new int/bool CVars
    v.Push(0); v.Push(1); v.Push(1);
    // slomo_any_weapon (false=0), hregen_amount, aregen_amount
  }

  static void DefaultFloats(out Array<double> v)
  {
    v.Push(0.10); v.Push(0.20); v.Push(0.90); v.Push(0.50); v.Push(1.00);
    v.Push(0.50); v.Push(0.60); v.Push(0.10); v.Push(0.20); v.Push(1.00);
    v.Push(0.80); v.Push(1.00); v.Push(0.80); v.Push(1.00); v.Push(0.875);
    v.Push(0.70); v.Push(0.90); v.Push(0.80); v.Push(0.60); v.Push(0.25); v.Push(0.50);
    v.Push(28.0); v.Push(7.00); v.Push(5.00); v.Push(0.20); v.Push(0.50);
    v.Push(7.00); v.Push(10.0);
    v.Push(1.00); v.Push(0.20); v.Push(0.50); v.Push(0.90); v.Push(4.00); v.Push(0.70); v.Push(1.00);
    v.Push(1.00); v.Push(1.00); v.Push(10.0); v.Push(0.20); v.Push(0.990);
    v.Push(0.010); v.Push(0.95); v.Push(0.50); v.Push(0.50);
    v.Push(1.00); v.Push(0.50); v.Push(0.10); v.Push(0.50); v.Push(1.00);
    v.Push(6.00); v.Push(0.80); v.Push(0.90); v.Push(0.010);
    v.Push(1.00); v.Push(0.20); v.Push(5.00); v.Push(5.00); v.Push(5.00);
    v.Push(0.90); v.Push(3.00); v.Push(0.20); v.Push(0.80);
    v.Push(1.00); v.Push(1.00); // damage_to_xp, score_to_xp
    v.Push(0.50); v.Push(0.50); // level_cost_mul_for_melee, _wimpy
    v.Push(2.00); v.Push(1.50); // power_curve_exponent, exp_curve_base
    v.Push(1.50); v.Push(2.00); v.Push(1.50); v.Push(2.00); v.Push(0.00); v.Push(0.00); // hybrid: exp_base_a, exp_base_b, power_a, power_b, bias, smooth
    v.Push(0.08); v.Push(3.0); // overdrive: damage_per_stack, window_secs
    // Hyper-V float scaling CVars
    v.Push(0.10); v.Push(0.10); v.Push(0.5); v.Push(1.0); v.Push(0.05); v.Push(0.05);
    // mobility_cd_per_level, melee_cd_per_level, hregen_tick_per_level, ammoregen_tick_per_level, agility_speed_per_level, agility_jump_per_level
    // Hyper-V float base value CVars
    v.Push(1.0);  v.Push(0.2);  // mobility_base_cooldown, mobility_min_cooldown
    v.Push(5.0);  v.Push(3.5);  v.Push(2.5); v.Push(1.0); // hregen_tick_lv1/2/3, hregen_min_tick
    v.Push(6.0);  v.Push(4.0);  // aregen_tick_lv1, aregen_tick_lv2
    v.Push(10.0); v.Push(6.0);  v.Push(2.0); // ammoregen_tick_lv1/2, ammoregen_min_tick
    v.Push(1.25); v.Push(1.35); // agility_base_speed, agility_base_jump
    v.Push(1.5);  v.Push(0.75); // tp_cd_lv1, tp_cd_lv2
    // Hook stun scaling CVars
    v.Push(2.0);  v.Push(4.0);  v.Push(0.5); v.Push(1.0);
    // hook_stun_min_base, hook_stun_max_base, hook_stun_min_per_level, hook_stun_max_per_level
    // Blood — mult, stacks_per_damage, softcap, drain_pct, stack_drain_rate, heal_ratio, vitaldrain_bonus, burst_ratio
    v.Push(1.00); v.Push(0.50); v.Push(20.0); v.Push(0.015); v.Push(0.20);
    v.Push(0.40); v.Push(0.50); v.Push(0.020);
  }

  static void BalancedFloats(out Array<double> v)
  {
    v.Push(0.07); v.Push(0.12); v.Push(0.92); v.Push(0.50); v.Push(0.50);
    v.Push(0.40); v.Push(0.48); v.Push(0.07); v.Push(0.14); v.Push(1.00);
    v.Push(0.85); v.Push(1.00); v.Push(0.85); v.Push(0.80); v.Push(0.875);
    v.Push(0.75); v.Push(0.92); v.Push(0.85); v.Push(0.60); v.Push(0.18); v.Push(0.40);
    v.Push(21.0); v.Push(5.00); v.Push(3.50); v.Push(0.12); v.Push(0.40);
    v.Push(5.50); v.Push(8.00);
    v.Push(0.85); v.Push(0.15); v.Push(0.50); v.Push(0.90); v.Push(2.80); v.Push(0.78); v.Push(0.70);
    v.Push(0.85); v.Push(0.80); v.Push(10.0); v.Push(0.25); v.Push(0.993);
    v.Push(0.007); v.Push(0.96); v.Push(0.50); v.Push(0.40);
    v.Push(0.85); v.Push(0.40); v.Push(0.08); v.Push(0.50); v.Push(0.75);
    v.Push(3.50); v.Push(0.85); v.Push(0.90); v.Push(0.007);
