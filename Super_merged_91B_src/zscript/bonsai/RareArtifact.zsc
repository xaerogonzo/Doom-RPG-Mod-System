// Rare artifact: a rare pickup that gives the equipped weapon ONE free upgrade choice.
//
// Where it comes from (all rolled once, never on touch, so nothing can be farmed by walking over an item):
//  - spawned beside a vanilla power-up when the level loads (TFLV_EventHandler.WorldThingSpawned),
//  - dropped by a +BOSS monster when it dies (TFLV_EventHandler.WorldThingDied).
// Every source has its own percentage slider (0 = off) plus a master switch and a per-map cap; see CVARINFO.
//
// Picking it up opens the normal weapon upgrade menu through its own giver. It never changes the weapon's level,
// XP, bonus levels or the player's XP, and it skips the respec and Legendoom checks of an ordinary level-up.
// #namespace TFLV;

// Giver for exactly one free choice. It keeps its own identity, so it can wait behind an open ordinary level-up
// (UpgradeGiver.AwaitChoice) without taking or losing anything. Created and started by TFLV_RareArtifact.TryPickup.
class TFLV_ArtifactUpgradeGiver : TFLV_WeaponUpgradeGiver {
  // The artifact starts this giver itself (candidates are created up front, so an empty list can refuse the pickup).
  override void PostBeginPlay() {}

  override void InstallUpgrade(int index) {
    if (!wielded || !wielded.wpn || !wielded.wpn.owner) { Destroy(); return; }
    let owner_pawn = wielded.wpn.owner;
    if (index < 0 || candidates.size() == 0) {
      // Declined: the artifact is not lost, it drops back at the player's feet.
      Actor.Spawn("TFLV_RareArtifact", owner_pawn.pos);
      Destroy();
      return;
    }
    wielded.FinishFreeUpgrade(TFLV_Upgrade_BaseUpgrade(new(candidates[index].GetClassName())));
    if (bonsai_autosave_after_level && wielded.stats) wielded.stats.Autosave();
    Destroy();
  }
}

class TFLV_RareArtifact : Inventory {
  int nextRefuseMsg;

  Default {
    +Inventory.AlwaysPickup;
    +Inventory.IgnoreSkill;
    +NoGravity;
    +Bright;
    Radius 16;
    Height 16;
    Inventory.PickupMessage "";
    Inventory.PickupSound "";
  }

  States {
    Spawn:
      RGEM ABCDCB 6 Bright;
      Loop;
  }

  // Who can use it: Gun Bonsai on, artifact master switch on, a player whose current weapon exists and is not
  // ignored. (An ignored weapon can still have an info object, so null-checking it is not enough.)
  static TFLV_WeaponInfo EligibleInfo(Actor who) {
    let h = TFLV_EventHandler(StaticEventHandler.Find("TFLV_EventHandler"));
    if (!h || !h.BonsaiEnabled() || !bonsai_artifact_enabled) return null;
    let pp = PlayerPawn(who);
    if (!pp) return null;
    let stats = TFLV_PerPlayerStats.GetStatsFor(pp);
    if (!stats) return null;
    let info = stats.GetInfoForCurrentWeapon();
    if (!info || info.IsIgnored()) return null;
    return info;
  }

  override bool TryPickup(in out Actor toucher) {
    let info = EligibleInfo(toucher);
    if (!info) return Refuse(toucher, "$TFLV_MSG_ARTIFACT_NO_WEAPON");

    let giver = TFLV_ArtifactUpgradeGiver(toucher.GiveInventoryType("TFLV_ArtifactUpgradeGiver"));
    if (!giver) return false;
    giver.wielded = info;
    giver.nrof = 1;
    giver.CreateUpgradeCandidates();
    if (giver.candidates.size() == 0) {
      // Nothing to offer for this weapon: keep the artifact on the floor.
      giver.Destroy();
      return Refuse(toucher, "$TFLV_MSG_ARTIFACT_NO_CHOICE");
    }
    giver.SetStateLabel("ChooseUpgrade");

    toucher.A_Log(StringTable.Localize("$TFLV_MSG_ARTIFACT_USED"), true);
    if (TFLV_Settings.levelup_sound() != "") {
      toucher.A_StartSound(TFLV_Settings.levelup_sound(), CHAN_AUTO, CHANF_OVERLAP|CHANF_UI|CHANF_NOPAUSE|CHANF_LOCAL);
    }
    GoAwayAndDie();
    return true;
  }

  // The artifact stays where it is; the message is shown at most every two seconds while the player touches it.
  bool Refuse(Actor toucher, string msg) {
    if (level.time >= nextRefuseMsg) {
      nextRefuseMsg = level.time + 70;
      toucher.A_Log(StringTable.Localize(msg), true);
    }
    return false;
  }

  // Spawns one artifact next to 'at' (or on it if there is no room). Returns it, or null. Counts against the per-map cap.
  static Actor SpawnNear(Actor at) {
    let h = TFLV_EventHandler(StaticEventHandler.Find("TFLV_EventHandler"));
    if (!h || !h.ArtifactCapOpen()) return null;
    double ang = random[TFLV_Upgrade_RNG_Artifact](0, 359);
    let a = Actor.Spawn("TFLV_RareArtifact", at.Vec3Angle(at.radius + 24, ang, 0));
    if (!a) return null;
    if (!a.TestMobjLocation()) a.SetOrigin(at.pos, false);
    h.ArtifactCounted();
    return a;
  }

  // Roll once at the displayed percentage (0 never, 100 always) and spawn on success.
  static void Roll(Actor at, double chance) {
    if (chance <= 0) return;
    if (chance < 100.0 && frandom[TFLV_Upgrade_RNG_Artifact](0, 100) >= chance) return;
    SpawnNear(at);
  }
}
