// #namespace TFLV::Upgrade;
// #debug off;

class TFLV_Upgrade_ECM : TFLV_Upgrade_BaseUpgrade {
  override bool IsSuitableForPlayer(TFLV_PerPlayerStats info) const {
    return true;
  }

  // Range at which we try to hack incoming missiles.
  uint EcmRange(uint level) {
    return bonsai_stat_ecm_base_range + level*bonsai_stat_ecm_range_per_level;
  }

  // Range within which we search for enemies to redirect against.
  uint LockRange(uint level) {
    return bonsai_stat_ecm_lock_base + level*bonsai_stat_ecm_lock_per_level;
  }

  // Chance, per shot, that if we couldn't redirect a missile we are unable to
  // reprogram it to home in on its launcher instead.
  float UnhackableChance(uint level) {
    // 20%/level with diminishing returns.
    return 0.8 ** level;
  }

  // Missiles that may still need a decision. Filled by OnHostileMissileSpawned (event driven)
  // instead of scanning every actor each tic. Entries leave the list once decided, dead, or
  // when their tracer turns out to be someone else.
  // born[i] is -1 for a missile that is known to be a seeker, otherwise the tic it spawned:
  // a missile that is not (yet) +SEEKERMISSILE is only kept for GRACE_TICS tics, in case an
  // actor sets the flag from its first state.
  Array<Actor> pending;
  Array<int> born;
  const GRACE_TICS = 5;
  // gametic of the last Tick. A gap (ECM toggled off, player frozen, map change, old save)
  // means missiles may have been missed, so the list is rebuilt with one full scan.
  int last_tick;
  // Outcome tallies (cheap integers; read by the debug dump so tests can see what happened).
  uint n_redirected, n_reprogrammed, n_failed;

  // Called from WorldThingSpawned for every missile not fired by a player. A tracer is usually
  // not set yet at this point (e.g. A_SkelMissile assigns it just after spawning), so only
  // remember the missile; Tick reads the tracer later.
  override void OnHostileMissileSpawned(Actor pawn, Actor shot) {
    pending.Push(shot);
    born.Push(shot.bSEEKERMISSILE ? -1 : gametic);
  }

  private void Prime(Actor owner) {
    pending.Clear();
    born.Clear();
    ThinkerIterator it = ThinkerIterator.Create("Actor", Thinker.STAT_DEFAULT);
    Actor shot;
    while (shot = Actor(it.next())) {
      if (shot.bSEEKERMISSILE && shot.bMISSILE && shot.tracer == owner && !shot.bINCOMBAT) {
        pending.Push(shot);
        born.Push(-1);
      }
    }
  }

  private void Forget(int i) {
    pending.Delete(i);
    born.Delete(i);
  }

  // --- The three outcomes. Each happens in exactly one place, once per missile. ---

  // Outcome 1: redirected against a nearby monster.
  private void Redirect(Actor owner, Actor shot, Array<Actor> monsters) {
    ++n_redirected;
    shot.tracer = monsters[random[TFLV_Upgrade_RNG_ECMTarget](0, monsters.size()-1)];
    shot.target = owner;
  }

  // Outcome 2: reprogrammed to hunt its launcher.
  private void Reprogram(Actor owner, Actor shot) {
    ++n_reprogrammed;
    shot.tracer = shot.target;
    shot.target = owner;
  }

  // Outcome 3: hack failed. We set the +INCOMBAT flag to keep track of shots we've already tried
  // and failed to redirect.
  // This shouldn't break anything since this flag is normally used to control
  // Strife dialogue and homing missiles are not known for being particularly
  // conversational.
  private void Fail(Actor owner, Actor shot) {
    ++n_failed;
    shot.bINCOMBAT = true;
  }

  override void Tick(Actor owner) {
    if (gametic != last_tick + 1) Prime(owner);
    last_tick = gametic;
    if (pending.Size() == 0) return;
    let radius = EcmRange(self.level);
    Array<Actor> monsters; bool did_monsters = false;
    for (int i = pending.Size() - 1; i >= 0; --i) {
      Actor shot = pending[i];
      // Gone, exploded, already handled, or aimed at somebody else: forget it. A tracer that is
      // still null stays listed, since it may be assigned a tic or two after spawning.
      if (!shot || !shot.bMISSILE || shot.bINCOMBAT || (shot.tracer && shot.tracer != owner)) {
        Forget(i);
        continue;
      }
      // Not a seeker (yet): give it a few tics to become one, then forget it.
      if (born[i] >= 0) {
        if (!shot.bSEEKERMISSILE) {
          if (gametic - born[i] > GRACE_TICS) Forget(i);
          continue;
        }
        born[i] = -1;
      } else if (!shot.bSEEKERMISSILE) {
        Forget(i);
        continue;
      }
      // Not (yet) aimed at the player, or still out of range: check again next tic.
      if (shot.tracer != owner || owner.Distance3D(shot) > radius) continue;
      // Found a seeker missile aimed at the player. It is decided now and leaves the list.
      Forget(i);
      // First, try to redirect it against a nearby enemy.
      if (!did_monsters) {
        TFLV_Util.MonstersInRadius(owner, LockRange(self.level), monsters);
        did_monsters = true;
      }
      if (monsters.size()) {
        Redirect(owner, shot, monsters);
      } else if (frandom[TFLV_Upgrade_RNG_ECMHack](0.0, 1.0) >= UnhackableChance(self.level)) {
        // Else we have a chance to reprogram it to hunt its creator.
        Reprogram(owner, shot);
      } else {
        Fail(owner, shot);
      }
    }
  }

  override void GetTooltipFields(Dictionary fields, uint level) {
    fields.insert("ecm-range", AsMeters(EcmRange(level)));
    fields.insert("lock-range", AsMeters(LockRange(level)));
    fields.insert("ecm-chance", AsPercent(1.0 - UnhackableChance(level)));
  }
}

