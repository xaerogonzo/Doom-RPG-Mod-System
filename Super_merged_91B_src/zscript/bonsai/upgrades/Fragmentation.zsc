// #namespace TFLV::Upgrade;
// #debug off

class TFLV_Upgrade_FragmentationShots : TFLV_Upgrade_BaseUpgrade {
  int last_frag_tic; // gametic of last fragment ring fired — gates one ring per tic

  override TFLV_Upgrade_UpgradePriority Priority() { return TFLV_Upgrade_PRI_FRAGMENTATION; }

  override void OnProjectileCreated(Actor pawn, Actor shot) {
    shot.GiveInventoryType("TFLV_Upgrade_FragmentationShots_Marker");
//    DEBUG("Tagging %s", shot.GetTag());
//    DEBUG("Shot inventory: %s", TAG(shot));
  }

  override void OnDamageDealt(Actor pawn, Actor shot, Actor target, int damage) {
    // Trigger only once for each shot, so that e.g. a rocket spawns one blast of
    // fragments, rather than one blast per enemy damaged by it.
    if (!shot || !shot.FindInventory("TFLV_Upgrade_FragmentationShots_Marker")) return;
    shot.TakeInventory("TFLV_Upgrade_FragmentationShots_Marker", 999);

    // One ring per tic per weapon. Prevents spread weapons (shotguns, etc.) from
    // spawning N simultaneous rings when multiple pellets hit in the same tic —
    // which was never intentional and could severely tank performance.
    if (last_frag_tic == gametic) return;
    last_frag_tic = gametic;

    let boom = TFLV_Upgrade_FragmentationShots_Boom(shot.Spawn("TFLV_Upgrade_FragmentationShots_Boom", shot.pos));
    boom.weaponspecial = Priority();
    boom.target = pawn;
    boom.tracer = target; // So that it knows which enemy to ignore
    boom.level = level;
    boom.damage = ceil(damage * bonsai_stat_frag_damage);
  }

  override bool IsSuitableForWeapon(TFLV_WeaponInfo info) const {
    return info.IsProjectile()
      && !info.IsRipper()
      && !info.IsMelee();
  }
  override void GetTooltipFields(Dictionary fields, uint level) {
    fields.insert("fragments", ""..(bonsai_stat_frag_base_count + bonsai_stat_frag_per_level*level));
    fields.insert("frag-damage", AsPercent(bonsai_stat_frag_damage));
    fields.insert("frag-arc", bonsai_stat_frag_arc >= 0.99 ? "360° ring" : string.format("%.0f° arc", bonsai_stat_frag_arc * 360.0));
  }
}

class TFLV_Upgrade_FragmentationShots_Marker : Inventory {
  property Priority: weaponspecial;
  Default { TFLV_Upgrade_FragmentationShots_Marker.Priority TFLV_Upgrade_PRI_FRAGMENTATION; }
}

class TFLV_Upgrade_FragmentationShots_Boom : Actor {
  uint level;
  uint damage;

  Default {
    +NOBLOCKMAP;
    +NOGRAVITY;
    +NODAMAGETHRUST;
    RenderStyle "Translucent";
    Alpha 0.5;
    Scale 1.0;
  }

  void Explode() {
    let nfragments = bonsai_stat_frag_base_count + bonsai_stat_frag_per_level*level;
    let trail = TFLV_Settings.vfx_for("bonsai_vfx_frag") == TFLV_VFX_FULL;
    double arc = 360.0 * clamp(bonsai_stat_frag_arc, 0.01, 1.0);
    for (uint i = 0; i < nfragments; ++i) {
      double angle = arc/nfragments * i - arc/2.0;
      let aux = TFLV_Upgrade_FragmentationShots_Fragment(
        A_SpawnProjectile(
          trail ? "TFLV_Upgrade_FragmentationShots_Fragment" : "TFLV_Upgrade_FragmentationShots_NoTrailFragment",
          0, 0, angle,
          CMF_AIMDIRECTION|CMF_TRACKOWNER,
          random[TFLV_Upgrade_RNG_FragAngle](-1.0,1.0)));
      aux.target = self.target;
      aux.tracer = self.tracer;
      aux.customdamage = self.damage;
      aux.bTHRUACTORS = false;
//      DEBUG("Spawned projectile %s angle=%d target=%s tracer=%s damage=%d",
//        TAG(aux), angle, TAG(aux.target), TAG(aux.tracer), aux.damage);
    }
  }

  States {
    Spawn:
      TNT1 A 3; // the fragments take a few millis to travel
      TNT1 A 0 Explode();
      LFRG CDE 2;
      STOP;
  }
}

class TFLV_Upgrade_FragmentationShots_Fragment : FastProjectile {
  uint customdamage;
  property UpgradePriority: weaponspecial;
  Default {
    TFLV_Upgrade_FragmentationShots_Fragment.UpgradePriority TFLV_Upgrade_PRI_FRAGMENTATION;
    Radius 2;
    Height 2;
    Speed 30;
    Damage 1; // uses customdamage via DoSpecialDamage() instead
    MissileType "TFLV_Upgrade_FragmentationShots_Trail";
    MissileHeight 8;
    Scale 0.4;
    Alpha 0.9;
    RenderStyle "Add";
    PROJECTILE;
    +THRUACTORS; // used to disable collision when first spawned; gets turned on after.
  }

  States {
    Spawn:
      LPUF A 1 BRIGHT;
      LOOP;
    Crash:
    Death:
      LPUF ABCD 2 BRIGHT;
      STOP;
    XDeath:
      STOP;
  }

  override int DoSpecialDamage(Actor target, int damage, Name damagetype) {
    return customdamage;
  }

  override bool CanCollideWith(Actor other, bool passive) {
    // Don't collide with the player, or with the monster they just shot.
//    DEBUG("CanCollide? other=%s target=%s tracer=%s other=target? %d other=tracer? %d",
//      TAG(other), TAG(self.target), TAG(self.tracer), other == self.target, other == self.tracer);
    return other != self.tracer && other != self.target;
  }
}

class TFLV_Upgrade_FragmentationShots_NoTrailFragment : TFLV_Upgrade_FragmentationShots_Fragment {
  Default { MissileType "None"; }
}

class TFLV_Upgrade_FragmentationShots_Trail : Actor {
  Default {
    Speed 0;
    Scale 0.4;
    Alpha 0.75;
    RenderStyle "Add";
    +NOBLOCKMAP;
    +NOGRAVITY;
    +NOTELEPORT;
    +CANNOTPUSH;
    +NODAMAGETHRUST;
  }

  States {
    Spawn:
      LPUF A 1 BRIGHT A_FadeOut(0.3);
      LOOP;
  }
}

