// Info about a single weapon. These are held by the PerPlayerStats and each
// one records information about one of the player's weapons.
// It's also responsible for handling weapon level-ups.
// #namespace TFLV;

class TFLV_WeaponInfo : Object play {
  // At the moment "wpn" is used both as a convenient way to remember a reference
  // to the weapon itself, and as the key for the info lookup when the caller has
  // a weapon but not the WeaponInfo.
  // We call it "wpn" rather than "weapon" because ZScript gets super confused
  // if we have both a type and an instance variable in scope with the same name.
  // Sigh.
  Weapon wpn;
  string wpnClass;
  TFLV_PerPlayerStats stats;
  TFLV_Upgrade_UpgradeBag upgrades;
  TFLV_LegendoomWeaponInfo ld_info;  // Legendoom effect state (null-safe when LD absent)
  double XP;         // total XP earned ever
  double maxXP;      // XP at which next level is earned
  uint level;        // current level, resets to 0 on respec
  uint bonus_levels; // "free" levels that don't use XP and can't be rerolled, used when respeccing

  // Called when a new WeaponInfo is created. This should initialize the entire object.
  void Init(Weapon wpn) {
//    DEBUG("Initializing WeaponInfo for %s", TAG(wpn));
    upgrades = new("TFLV_Upgrade_UpgradeBag");
    ld_info  = new("TFLV_LegendoomWeaponInfo");
    ld_info.Init(self);
    Rebind(wpn);
    XP = 0;
    level = 0;
//    DEBUG("WeaponInfo initialize, class=%s level=%d xp=%d/%d",
//        wpnClass, level, XP, maxXP);
  }

  // Called when this WeaponInfo is being reassociated with a new weapon. It
  // should keep most of its stats.
  void Rebind(Weapon wpn) {
    self.wpn = wpn;
    if (self.wpnClass != wpn.GetClassName()) {
      // Rebinding to a weapon of an entirely different type. Reset the attack
      // modality inference counters.
      self.wpnClass = wpn.GetClassName();
      self.ResetTypeInference();
      TFLV_RC.GetRC().Configure(self);
      if (!wpn.bPOWERED_UP || !maxXP)
        // Use TotalXPForLevel — maxXP is compared against total-XP-ever-earned,
        // not per-level cost. GetXPForLevel was wrong for any level > 1.
        self.maxXP = TotalXPForLevel(level+1);
    }
    if (TFLV_Settings.have_legendoom()) {
      ld_info.Rebind(self);
      ld_info.ValidateCurrentEffect();
    }
  }

  void ToggleUpgrade(uint index) {
    let upgrade = upgrades.upgrades[index];
    upgrade.enabled = !upgrade.enabled;
    if (upgrade.enabled) {
      upgrade.OnActivate(stats, self);
    } else {
      upgrade.OnDeactivate(stats, self);
    }
  }

  void TuneUpgrade(uint index, int amount) {
    let upgrade = upgrades.upgrades[index];
    if (!upgrade.enabled) return;
    let old_level = upgrade.level;
    upgrade.level = clamp(upgrade.level + amount, 1, upgrade.max_level);
    if (old_level != upgrade.level) {
      upgrade.OnDeactivate(stats, self);
      upgrade.OnActivate(stats, self);
    }
  }

  void OnActivate() {
    self.upgrades.OnActivate(stats, self);
  }
  void OnDeactivate() {
    self.upgrades.OnDeactivate(stats, self);
  }

  // List of upgrade classes that are unavailable on this weapon, even if they
  // would normally spawn.
  array<string> disabled_upgrades;
  void DisableUpgrades(array<string> upgrades) {
    disabled_upgrades.copy(upgrades);
  }
  bool CanAcceptUpgrade(string upgrade) {
    return disabled_upgrades.find(upgrade) == disabled_upgrades.size();
  }

  // List of classes that this weapon is considered equivalent to.
  array<string> equivalencies;
  void SetEquivalencies(array<string> classes) {
    equivalencies.copy(classes);
  }

  bool IsEquivalentTo(Weapon wpn) {
    let result = wpn.GetClassName() == self.wpnClass
      || equivalencies.find(wpn.GetClassName()) != equivalencies.size();
//    DEBUG("Eqv? %s %s -> %d", wpnClass, TAG(wpn), result);
    return result;
  }

  // Given another weapon to look at, determine if this WeaponInfo can be rebound
  // to it. The actual logic used depends on the bonsai_upgrade_binding_mode cvar.
  bool CanRebindTo(Weapon wpn) {
    TFLV_UpgradeBindingMode mode = bonsai_upgrade_binding_mode;

    // SisterWeapon overrides everything else; a weapon and its sister are always
    // considered to share a binding regardless of binding mode.
    if (self.wpn && self.wpn.SisterWeapon == wpn) return true;

    // Can't rebind at all in BIND_WEAPON mode under normal circumstances.
    // As a special case, we will permit rebinds if:
    // - the new weapon has a different class from the old one;
    // - the old weapon no longer exists;
    // - the two classes are marked equivalent in BONSAIRC.
    if (mode == TFLV_BIND_WEAPON) {
//      DEBUG("BIND_WEAPON reuse check: orphaned=%d equivalent=%d",
//        self.wpn == null, IsEquivalentTo(wpn));
      return
        self.wpnClass != wpn.GetClassName()
        && self.wpn == null
        && IsEquivalentTo(wpn);
    }

    // In class-bound mode, all weapons of the same type share the same WeaponInfo.
    // When you switch weapons, the WeaponInfo for that type gets rebound to the
    // newly wielded weapon.
    if (mode == TFLV_BIND_CLASS) {
      return IsEquivalentTo(wpn);
    }

    // In inheritable weapon-bound mode, a weaponinfo is only reusable if the
    // weapon it was bound to is no longer carried by the player.
    if (mode == TFLV_BIND_WEAPON_INHERITABLE) {
      // We need IsReallyInInventory here because sometimes, for some reason,
      // PlayerPawn.RemoveInventory(i) doesn't set i.owner to null, even though
      // it absolutely should and the source code says it does, and this is most
      // obvious when dealing with Universal Pistol Start.
      return (self.wpn == null || self.wpn.owner == null || !IsReallyInInventory(wpn.owner, self.wpn))
        && self.IsEquivalentTo(wpn);
    }

    ThrowAbortException("Unknown UpgradeBindingMode %d!", mode);
    return false;
  }

  bool IsReallyInInventory(Actor stack, Actor needle) {
    for (Inventory inv = stack.inv; inv; inv = inv.inv) {
      if (inv == needle) return true;
    }
    return false;
  }

  // Returns the cost to get from level 0 to the given level. This is integral
  // of the XP curve from 0 to the given level.
  // We can do this just by iterating over the XP cost for each level, but
  // instead we implement the closed form of each here.
  // XP curve indices: 0=Custom Power, 1=Custom Exponential, 2=Hybrid
  // Note: Custom Power with exponent 0 is equivalent to Constant (level^0 = 1).
  double TotalXPForLevel(uint level) const {
    switch (bonsai_xp_curve) {
      case 0:  // custom power: base_cost * level^x.
               // No general closed form for non-integer x — iterate.
               // Special case: exponent 0 gives base_cost * 1 = constant.
      {
        double total = 0.0;
        for (uint lv = 1; lv <= level; ++lv)
          total += GetXPForLevel(lv);
        return total;
      }
      case 1:  // custom exponential: base_cost * base^(level-1).
               // Closed form: base * (base^level - 1) / (base - 1)
               // Guard against base == 1 (degenerate, approaches constant).
      {
        double b = bonsai_exp_curve_base;
        if (abs(b - 1.0) < 0.0001) return GetBaseXP() * level;
        return GetBaseXP() * (b ** level - 1.0) / (b - 1.0);
      }
      case 2:  // hybrid: blends custom exponential into custom power.
               // No closed form — sum per-level costs.
      {
        double total = 0.0;
        for (uint lv = 1; lv <= level; ++lv)
          total += GetXPForLevel(lv);
        return total;
      }
    }
    // Should never happen
    return 1e9999;
  }

  // Fire VUAS elemental master netevent if 4 or more elemental upgrade trees are
  // represented in this weapon's upgrade bag (any combination of the 5 elements).
  void CheckElementalMasterAchievement() {
    if (TFLV_Upgrade_ElementalUpgrade.GetElementCount(upgrades) >= 4)
      EventHandler.SendNetworkEvent("vuas_event:all_elements");
  }

  // Smoothstep with configurable bias. bias in (-1, 1):
  //   bias < 0 = transition happens faster at the start (ease-in)
  //   bias > 0 = transition happens slower at the start (ease-out)
  //   bias = 0 = standard symmetric smoothstep
  private static double BiasedSmoothstep(double t, double bias) {
    // Clamp t to [0,1]
    t = clamp(t, 0.0, 1.0);
    // Standard smoothstep
    double s = t * t * (3.0 - 2.0 * t);
    // Apply bias by raising to a power derived from bias
    // bias = 0 → power = 1 (no change)
    // bias = 0.99 → power ≈ 100 (very slow start)
    // bias = -0.99 → power ≈ 0.01 (very fast start)
    if (abs(bias) > 0.001) {
      double power = (bias >= 0)
        ? 1.0 + bias * 9.0          // 1..10 for bias 0..0.99
        : 1.0 / (1.0 - bias * 9.0); // 0.1..1 for bias -0.99..0
      s = s ** power;
    }
    return s;
  }

  // Cost of a single component (power or exponential) at a given level.
  private static double ComponentCost(int type, double baseCost,
                                      double expBase, double powerExp, int level) {
    if (level <= 0) return 0.0;
    switch (type) {
      case 1:  // exponential: base_cost * expBase^(level-1)
        return baseCost * (expBase ** (level - 1));
      default: // power (0): base_cost * level^powerExp
        return baseCost * (level ** powerExp);
    }
  }

  // Raw hybrid cost at a given level, without smoothing.
  private double HybridCostAt(int level) const {
    double base   = GetBaseXP();
    double costA  = ComponentCost(bonsai_hybrid_component_a, base,
                                  bonsai_hybrid_exp_base_a, bonsai_hybrid_power_a, level);
    double costB  = ComponentCost(bonsai_hybrid_component_b, base,
                                  bonsai_hybrid_exp_base_b, bonsai_hybrid_power_b, level);
    double tStart = bonsai_hybrid_transition_start;
    double tEnd   = bonsai_hybrid_transition_end;
    double t      = (tEnd > tStart)
      ? (double(level) - tStart) / (tEnd - tStart)
      : (level >= tEnd ? 1.0 : 0.0);
    double blend  = BiasedSmoothstep(t, bonsai_hybrid_bias);
    return costA * (1.0 - blend) + costB * blend;
  }

  // Returns the cost to reach the given level from the previous level.
  // Curve indices: 0=Custom Power, 1=Custom Exponential, 2=Hybrid
  double GetXPForLevel(uint level) const {
    switch (bonsai_xp_curve) {
      case 0:  // custom power: base_cost * level^exponent
               // exponent 0 → level^0 = 1 → constant cost (same as old Constant curve)
        return level ? GetBaseXP() * (level ** bonsai_power_curve_exponent) : 0.0;
      case 1:  // custom exponential: base_cost * base^(level-1)
        return level ? GetBaseXP() * (bonsai_exp_curve_base ** (level - 1)) : 0.0;
      case 2:  // hybrid: blends two curve components with biased smoothstep
               // bonsai_hybrid_invert=false: exp→power (default)
               // bonsai_hybrid_invert=true:  power→exp
               // bonsai_hybrid_smooth: averages cost over a window to reduce sharp transitions
      {
        if (!level) return 0.0;
        int smooth = clamp(bonsai_hybrid_smooth, 0, 15);
        if (smooth == 0)
          return HybridCostAt(level);
        // Weighted average over [level-smooth .. level+smooth]
        // Weight: triangular (closer = higher weight)
        double total  = 0.0;
        double wTotal = 0.0;
        for (int k = -smooth; k <= smooth; ++k) {
          int lv2 = level + k;
          if (lv2 < 1) lv2 = 1;
          double w = smooth + 1 - abs(k);
          total  += w * HybridCostAt(lv2);
          wTotal += w;
        }
        return total / wTotal;
      }
    }
    // Should never happen
    return 1e9999;
  }

  // Returns base XP cost for this weapon, i.e. the reference XP cost to go from
  // level 0 to level 1. This is configured by the user but may be modified for
  // certain classes of weapons.
  double GetBaseXP() const {
    double mul = 1.0;
    if (IsMelee()) {
      mul = min(mul, bonsai_level_cost_mul_for_melee);
    }
    if (IsWimpy()) {
      mul = min(mul, bonsai_level_cost_mul_for_wimpy);
    }
    return bonsai_base_level_cost * mul;
  }

  void AddXP(double newXP) {
    if (IsIgnored()) return;
//    DEBUG("Adding XP: %.3f + %.3f", XP, newXP);
    XP += newXP;
//    DEBUG("XP is now %.3f", XP);
    let xp_since = XP - GetXPForLevel(level);
    if (XP >= maxXP && XP - newXP < maxXP) {
      Fanfare();
    }
  }

  void Fanfare() {
    EventHandler.SendNetworkEvent("bonsai-level-up", 1, self.level+1);
    // VUAS achievement netevents for weapon level milestones
    if (self.level == 1) EventHandler.SendNetworkEvent("vuas_event:wpn_first_level");
    if (self.level >= 5) EventHandler.SendNetworkEvent("vuas_event:wpn_level_5");
    if (self.level >= 10) EventHandler.SendNetworkEvent("vuas_event:wpn_level_10");
    let flash = TFLV_Settings.levelup_flash();
    if (flash) {
      wpn.owner.A_SetBlend(flash, 0.8, 40);
    }
    if (TFLV_Settings.levelup_sound() != "") {
      wpn.owner.A_StartSound(TFLV_Settings.levelup_sound(), CHAN_AUTO,
        CHANF_OVERLAP|CHANF_UI|CHANF_NOPAUSE|CHANF_LOCAL);
    }
    if (0 <= bonsai_upgrade_choices_per_gun_level && bonsai_upgrade_choices_per_gun_level <= 1) {
      StartLevelUp();
    } else {
      wpn.owner.A_Log(string.format(
        StringTable.Localize("$TFLV_MSG_WEAPON_LEVELUP_READY"),
        wpn.GetTag()),
        true);
    }
  }

  // Amount of XP it took to reach this level.
  double BaseXP() { return TotalXPForLevel(self.level); }
  // Amount of XP we've gained since reaching this level.
  double LevelXP() { return XP - BaseXP(); }

  uint CountPendingLevels() {
    uint pending = bonus_levels;
    for (uint lv = level+1; TotalXPForLevel(lv) <= xp; ++lv) { ++pending; }
    return pending;
  }

  bool StartLevelUp() {
    if (!CountPendingLevels()) return false;

    let giver = TFLV_WeaponUpgradeGiver(wpn.owner.GiveInventoryType("TFLV_WeaponUpgradeGiver"));
    giver.wielded = self;

    if (bonsai_respec_interval) {
      // Check if any of the pending levels would trigger a respec.
      for (uint i = level+1; i <= level+CountPendingLevels(); ++i) {
        if (i % bonsai_respec_interval == 0) {
          // Respec triggered. Clear all existing upgrades.
          OnDeactivate(); upgrades.Clear();
          bonus_levels = level;
          break;
        }
      }
    }

    giver.nrof = CountPendingLevels();  // Includes bonus_levels

    // Legendoom: if LD is installed and this level is a multiple of the
    // configured interval, spawn an effect giver alongside the upgrade giver.
    if (TFLV_Settings.have_legendoom()
        && bonsai_gun_levels_per_ld_effect > 0
        && ((level + 1) % bonsai_gun_levels_per_ld_effect) == 0) {
      let ldGiver = TFLV_LegendoomEffectGiver(wpn.owner.GiveInventoryType("TFLV_LegendoomEffectGiver"));
      ldGiver.info = self.ld_info;
    }

    return true;
  }

  void RejectLevelUp() {
    if (bonus_levels) {
      --bonus_levels;
    } else {
      // Don't adjust maxXP -- they didn't gain a level.
      XP -= maxXP;
    }
    wpn.owner.A_Log(StringTable.Localize("$TFLV_MSG_LEVELUP_REJECTED"), true);
    if (XP >= maxXP) Fanfare();
    return;
  }

  void FinishLevelUp(TFLV_Upgrade_BaseUpgrade upgrade) {
    if (bonus_levels) {
      --bonus_levels;
    } else {
      ++level;
      TFLV_PerPlayerStats.GetStatsFor(wpn.owner).AddPlayerXP(1);
      maxXP = TotalXPForLevel(level+1);
    }
//    DEBUG("Level-up completed! xp=%d, base=%d, since=%d, next=%d",
//      xp, BaseXP(), LevelXP(), maxXP);

    if (upgrade) {
      let addedUpgrade = upgrades.AddUpgrade(upgrade);
      addedUpgrade.OnActivate(stats, self);
      wpn.owner.A_Log(string.format(
          StringTable.Localize("$TFLV_MSG_WEAPON_LEVELUP"),
          wpn.GetTag(), upgrade.GetName()),
        true);

      // VUAS achievement hooks
      EventHandler.SendNetworkEvent("vuas_event:first_upgrade");
      if (addedUpgrade.level >= 3)
        EventHandler.SendNetworkEvent("vuas_event:upgrade_level_3");

      // Elemental synthesis check
      if (upgrade.GetClass().GetClassName() == "TFLV_Upgrade_ElementalSynthesis")
        EventHandler.SendNetworkEvent("vuas_event:elemental_synthesis");

      // Arsenal: 5+ upgrades on one weapon
      if (upgrades.upgrades.Size() >= 5)
        EventHandler.SendNetworkEvent("vuas_event:all_upgrades_one_weapon");

      // XP comeback: leveled up after having XP penalty applied this session
      if (stats && stats.xpPenaltyAppliedThisSession)
        EventHandler.SendNetworkEvent("vuas_event:xp_comeback");

      // Elemental Master: all 4 elemental trees active on this weapon
      CheckElementalMasterAchievement();
    }
  }
}
